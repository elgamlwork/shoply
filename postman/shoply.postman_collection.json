{
  "info": {
    "name": "Shoply — DummyJSON",
    "description": "Endpoints used by the Shoply frontend. The Authorization tab on the Login request will populate a {{token}} variable for protected requests via the test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "shoply-dummyjson-collection"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dummyjson.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\",\n  \"expiresInMins\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (token required)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (paged)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?limit=12&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "limit", "value": "12" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "List products (sorted by price desc)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?limit=12&skip=0&sortBy=price&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "limit", "value": "12" },
                { "key": "skip", "value": "0" },
                { "key": "sortBy", "value": "price" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/search?q=phone&limit=12&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "q", "value": "phone" },
                { "key": "limit", "value": "12" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Products by category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/category/smartphones?limit=12&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["products", "category", "smartphones"],
              "query": [
                { "key": "limit", "value": "12" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Product by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/categories",
              "host": ["{{baseUrl}}"],
              "path": ["products", "categories"]
            }
          }
        }
      ]
    }
  ]
}
